# Copy to .env.local. Never commit real values.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
DATABASE_URL=
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini
# Local design work only: a scripted stand-in for the model, no spend.
AI_FAKE=false
# Which organisation the app shows (scripts/link-subscriptions.ts creates "larkhaven").
ORG_SLUG=
# Donor notes: sent with Resend, always to this one test inbox in the sandbox demo.
RESEND_API_KEY=
NOTE_INBOX=
# Optional: AG Studio licence (without one it runs as a watermarked trial).
NEXT_PUBLIC_AG_STUDIO_LICENSE=
